# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/insurance_ai?schema=public"

# Better Auth
BETTER_AUTH_SECRET="your-super-secret-key-at-least-32-chars-long"
BETTER_AUTH_URL="http://localhost:3000"

# Criptografia de Dados Sensíveis (AES-256-GCM / 32 bytes hex)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Redis (BullMQ para fila de renovações de 30 dias)
REDIS_URL="redis://localhost:6379"

# Provedores de IA (camada unificada AIProvider)
AI_DEFAULT_PROVIDER="openai" # openai | gemini | deepseek
OPENAI_API_KEY=""
GEMINI_API_KEY=""
DEEPSEEK_API_KEY=""

# WhatsApp Oficial (360dialog / Cloud API)
WHATSAPP_PROVIDER="dialog360" # dialog360 | cloudapi
DIALOG360_API_KEY=""
DIALOG360_WEBHOOK_SECRET=""
