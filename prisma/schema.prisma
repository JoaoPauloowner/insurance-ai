datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

// -----------------------------------------------------------------------------
// Better Auth - Modelos de Autenticação e Organização
// -----------------------------------------------------------------------------

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  role          String       @default("corretor") // owner, corretor, atendente
  susepRegistro String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]
  cotacoes      Cotacao[]
  sinistros     Sinistro[]
  auditLogs     AuditLog[]
  reviewedMsgs  Message[]    @relation("MessageReviewer")

  @@map("users")
}

model Session {
  id                   String        @id @default(cuid())
  userId               String
  token                String        @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  activeOrganizationId String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Organization {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  susepRegistro String?
  logo          String?
  metadata      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  members       Member[]
  invitations   Invitation[]
  clientes      Cliente[]
  apolices      Apolice[]
  cotacoes      Cotacao[]
  sinistros     Sinistro[]
  conversations Conversation[]
  messages      Message[]
  connections   WhatsappConnection[]
  auditLogs     AuditLog[]

  @@map("organizations")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String       @default("corretor")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("members")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           String
  status         String       @default("pending")
  expiresAt      DateTime
  inviterId      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("invitations")
}

// -----------------------------------------------------------------------------
// Domínio de Seguros (Todas com organizationId estrito para Multi-tenancy)
// -----------------------------------------------------------------------------

model WhatsappConnection {
  id              String       @id @default(cuid())
  organizationId  String
  phoneNumber     String
  apiKeyEncrypted String       // Chave 360dialog criptografada com AES-256-GCM
  webhookSecret   String?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("whatsapp_connections")
}

model Cliente {
  id             String       @id @default(cuid())
  organizationId String
  nome           String
  telefone       String
  cpfEncrypted   String       // CPF sempre criptografado (AES-256-GCM)
  email          String?
  endereco       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apolices       Apolice[]
  cotacoes       Cotacao[]
  conversations  Conversation[]

  @@index([organizationId])
  @@index([telefone])
  @@map("clientes")
}

model Apolice {
  id             String       @id @default(cuid())
  organizationId String
  clienteId      String
  seguradora     String       // Porto Seguro, Bradesco, SulAmérica, Allianz, etc.
  tipoSeguro     String       // auto, vida, residencial, saude, empresarial
  numeroApolice  String
  valorPremio    Decimal?     @db.Decimal(12, 2) // Preenchido APENAS por humano, NUNCA IA!
  dataInicio     DateTime
  dataVencimento DateTime     // Chave do Alerta de Renovação (janela de 30 dias)
  status         String       @default("ativa") // ativa, vencida, em_renovacao, cancelada
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cliente        Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  sinistros      Sinistro[]
  cotacoes       Cotacao[]

  @@index([organizationId])
  @@index([clienteId])
  @@index([dataVencimento])
  @@index([status])
  @@map("apolices")
}

model Cotacao {
  id             String       @id @default(cuid())
  organizationId String
  clienteId      String
  apoliceId      String?
  seguradora     String
  dadosEntrada   Json         // Requisitos, franquia, coberturas
  valorPremio    Decimal      @db.Decimal(12, 2) // Preenchido APENAS por humano
  status         String       @default("rascunho") // rascunho, enviada, aceita, recusada
  criadoPorId    String       // FK User — NUNCA nulo, sempre humano!
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cliente        Cliente      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  apolice        Apolice?     @relation(fields: [apoliceId], references: [id], onDelete: SetNull)
  criadoPor      User         @relation(fields: [criadoPorId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([clienteId])
  @@index([criadoPorId])
  @@map("cotacoes")
}

model Sinistro {
  id             String       @id @default(cuid())
  organizationId String
  apoliceId      String
  dataOcorrencia DateTime
  status         String       @default("aberto") // aberto, em_analise, finalizado
  descricao      String
  responsavelId  String?
  historico      Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apolice        Apolice      @relation(fields: [apoliceId], references: [id], onDelete: Cascade)
  responsavel    User?        @relation(fields: [responsavelId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([apoliceId])
  @@map("sinistros")
}

model Conversation {
  id             String       @id @default(cuid())
  organizationId String
  clienteId      String?
  remoteJid      String       // Identificador WhatsApp (5511999998888)
  status         String       @default("novo") // novo, qualificado, aguardando_cotacao, com_apolice
  lastMessageAt  DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cliente        Cliente?     @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  messages       Message[]

  @@unique([organizationId, remoteJid])
  @@index([organizationId])
  @@index([clienteId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  organizationId String
  conversationId String
  direction      String       // in, out
  content        String
  aiGenerated    Boolean      @default(false)
  requiresReview Boolean      @default(false)
  reviewStatus   String       @default("none") // none, pending_review, approved, edited, rejected
  reviewedById   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reviewedBy     User?        @relation("MessageReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([conversationId])
  @@index([reviewStatus])
  @@map("messages")
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  userId         String?
  acao           String       // CREATE, UPDATE, DELETE, VIEW_SENSITIVE, APPROVE_MESSAGE, REJECT_MESSAGE
  entidade       String       // Apolice, Cotacao, Sinistro, Cliente, Message
  entidadeId     String
  detalhes       Json?        // Dados mascarados sem CPF ou prêmio em plain text
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([entidade, entidadeId])
  @@index([createdAt])
  @@map("audit_logs")
}
